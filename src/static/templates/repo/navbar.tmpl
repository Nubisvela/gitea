{{$canReadCode := $.Permission.CanRead ctx.Consts.RepoUnitTypeCode}}

<div class="ui fluid vertical menu">
	{{/* the default activity page "pulse" could work with any permission: code, issue, pr, release*/}}
	<a class="{{if .PageIsPulse}}active {{end}}item" hx-get="{{.RepoLink}}/activity" hx-target="#main" hx-push-url="true">
		{{ctx.Locale.Tr "repo.activity.navbar.pulse"}}
	</a>
	{{if $canReadCode}}
		<a class="{{if .PageIsContributors}}active {{end}}item" hx-get="{{.RepoLink}}/activity/contributors" hx-target="#main" hx-push-url="true">
			{{ctx.Locale.Tr "repo.activity.navbar.contributors"}}
		</a>
		<a class="{{if .PageIsCodeFrequency}}active{{end}} item" hx-get="{{.RepoLink}}/activity/code-frequency" hx-target="#main" hx-push-url="true">
			{{ctx.Locale.Tr "repo.activity.navbar.code_frequency"}}
		</a>
		<a class="{{if .PageIsRecentCommits}}active{{end}} item" hx-get="{{.RepoLink}}/activity/recent-commits" hx-target="#main" hx-push-url="true">
			{{ctx.Locale.Tr "repo.activity.navbar.recent_commits"}}
		</a>
	{{end}}
</div>
